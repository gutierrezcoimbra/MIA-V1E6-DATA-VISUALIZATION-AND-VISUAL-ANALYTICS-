	/// Año-mes en formato aaaa-mm (ordena cronológicamente como texto).
	column year_month = FORMAT(dim_date[full_date], "yyyy-MM")
		dataType: string
		lineageTag: 64995a4d-9a15-4489-9365-2c85c3387eae
		summarizeBy: none

	/// Mes abreviado en español.
	column month_short =
			SWITCH(
			    dim_date[month_number_of_year],
			    1, "Ene", 2, "Feb", 3, "Mar", 4, "Abr", 5, "May", 6, "Jun",
			    7, "Jul", 8, "Ago", 9, "Sep", 10, "Oct", 11, "Nov", 12, "Dic",
			    ""
			)
		dataType: string
		lineageTag: 39177b87-4aeb-44e8-ad8b-f13f932c4005
		summarizeBy: none
		sortByColumn: month_number_of_year

