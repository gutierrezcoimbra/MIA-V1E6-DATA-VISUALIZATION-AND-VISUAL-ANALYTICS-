	column 'customer name' = "Comprador " & UPPER(RIGHT(dim_customer[customer_id], 5))
		lineageTag: cc0c68d9-c8b3-4d7b-b5cc-402762a30bc7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Región geográfica de Brasil a partir del estado del cliente.
	column customer_region =
			VAR s = dim_customer[customer_state]
			RETURN
			SWITCH(
			    TRUE(),
			    s IN {"AC", "AP", "AM", "PA", "RO", "RR", "TO"}, "Norte",
			    s IN {"AL", "BA", "CE", "MA", "PB", "PE", "PI", "RN", "SE"}, "Nordeste",
			    s IN {"DF", "GO", "MT", "MS"}, "Centro-Oeste",
			    s IN {"ES", "MG", "RJ", "SP"}, "Sudeste",
			    s IN {"PR", "RS", "SC"}, "Sur",
			    "Sin dato"
			)
		dataType: string
		lineageTag: 876db799-78a0-4667-af25-d8bab29147c9
		summarizeBy: none

	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RutaBase & "olist_customers_dataset.csv"), [Delimiter=",", Encoding=65001]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"customer_id", type text}, {"customer_unique_id", type text}, {"customer_zip_code_prefix", Int64.Type}, {"customer_city", type text}, {"customer_state", type text}}, "en-US"),
				    #"Merged Queries" = Table.NestedJoin(#"Changed Type", {"customer_zip_code_prefix"}, dim_geolocation, {"geolocation_zip_code_prefix"}, "dim_geolocation", JoinKind.LeftOuter),
				    #"Expanded dim_geolocation" = Table.ExpandTableColumn(#"Merged Queries", "dim_geolocation", {"geolocation_lat", "geolocation_lng"}, {"dim_geolocation.geolocation_lat", "dim_geolocation.geolocation_lng"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Expanded dim_geolocation",{{"dim_geolocation.geolocation_lat", "customer_geolocation_lat"}, {"dim_geolocation.geolocation_lng", "customer_geolocation_lng"}}),
				    #"Duplicados quitados" = Table.Distinct(#"Renamed Columns", {"customer_id"})
				in
				    #"Duplicados quitados"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

