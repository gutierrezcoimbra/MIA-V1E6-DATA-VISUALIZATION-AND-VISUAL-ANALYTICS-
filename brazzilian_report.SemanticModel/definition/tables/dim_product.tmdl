	column 'product name' = "Producto " & UPPER(RIGHT(dim_product[product_id], 5))
		lineageTag: 73e3b3dc-8fcb-45dd-9852-c09a7d50c89f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Categoría en inglés con formato legible; las vacías se agrupan en Sin categoría.
	column category_label =
			VAR c = dim_product[product_category_name_english]
			RETURN
			IF(
			    ISBLANK(c) || c = "",
			    "Sin categoría",
			    UPPER(LEFT(c, 1)) & SUBSTITUTE(MID(c, 2, 100), "_", " ")
			)
		dataType: string
		lineageTag: 28e26778-e039-433d-b105-57c6cf440ab5
		summarizeBy: none

	partition dim_product = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RutaBase & "dim_products.csv"), [Delimiter=",", Encoding=65001]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"product_id", type text}, {"product_category_name", type text}, {"product_name_lenght", Int64.Type}, {"product_description_lenght", Int64.Type}, {"product_photos_qty", Int64.Type}, {"product_weight_g", Int64.Type}, {"product_length_cm", Int64.Type}, {"product_height_cm", Int64.Type}, {"product_width_cm", Int64.Type}, {"product_category_name_english", type text}}, "en-US"),
				    #"Reordered Columns" = Table.ReorderColumns(#"Changed Type",{"product_id", "product_category_name", "product_category_name_english", "product_name_lenght", "product_description_lenght", "product_photos_qty", "product_weight_g", "product_length_cm", "product_height_cm", "product_width_cm"}),
				    #"Duplicados quitados" = Table.Distinct(#"Reordered Columns", {"product_id"})
				in
				    #"Duplicados quitados"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

